<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Student" />
    <Spinner
        android:id="@+id/spStudent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etSemester"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Semester (1-8)"
        android:inputType="number"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etGpa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="GPA (e.g. 8.5)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/cbBacklog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Has Backlog?" />

    <EditText
        android:id="@+id/etBacklogSubjects"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Backlog Subjects (optional)" />

</LinearLayout>
