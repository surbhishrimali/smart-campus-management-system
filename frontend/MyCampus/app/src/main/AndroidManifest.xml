<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyCampus"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".StudentResultsActivity"
            android:exported="false"
            android:label="My Results" />
        <activity
            android:name=".StudentAttendanceActivity"
            android:exported="false"
            android:label="My Attendance" />
        <activity
            android:name=".ResultManagementActivity"
            android:exported="false"
            android:label="Manage Results" />
        <activity
            android:name=".AttendanceManagementActivity"
            android:exported="false"
            android:label="Manage Attendance" />
        <activity
            android:name=".UploadResourceActivity"
            android:exported="false"
            android:label="@string/title_upload_resource" />
        <activity
            android:name=".NoticeActivity"
            android:exported="false"
            android:label="Notifications" />
        <activity
            android:name=".admindashboardActivity"
            android:exported="false" />
        <activity
            android:name=".StudentdashboardActivity"
            android:exported="false" />
        <activity
            android:name=".facultydsashboardActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AttendanceActivity"
            android:exported="false"
            android:label="@string/title_attendance_tracker" />
        <activity
            android:name=".ResourcesActivity"
            android:exported="false"
            android:label="@string/title_semester_resources" />
        <activity
            android:name=".second"
            android:exported="false" />
    </application>

</manifest>